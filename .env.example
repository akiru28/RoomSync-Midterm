NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lecture_room_reservation

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Use a unique secret with at least 32 characters in production.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@school.edu

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
